# 复制成 .env 再按需改: cp .env.example .env
#
# 这个文件会被 git 忽略, 里面可以写密码, 不会误提交。

# VNC / noVNC 密码。
# 留空(或整行删掉)= 容器每次启动时随机生成, 打印在 docker compose logs 里,
# 并保存到 ./.data/config/.vnc-password, 重启容器沿用同一把。
VNC_PASSWORD=

# 虚拟屏分辨率。宽屏显示器用 1920x1080x24, 小屏或怕卡可以降到 1280x720x24。
SCREEN=1920x1080x24

# noVNC 网页端口(宿主机侧)。6080 被占了就改这里。
WEB_PORT=6080

# 时区
TZ=Asia/Shanghai

# 使用的镜像。默认拉 Docker Hub 上的; 想本地构建就 docker compose up -d --build
IMAGE=planlx/baidunetdisk-container:latest
